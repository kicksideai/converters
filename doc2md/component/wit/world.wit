package kickside:doc2md;

world converter {
    record image {
        name: string,
        data: list<u8>,
        page: option<u32>,
    }

    // Inclusive 1-based page range. `last` past the final page selects through
    // the final page; `first` must name an existing page. A document without
    // pages (anything but PDF) is one page.
    record page-range {
        first: u32,
        last: u32,
    }

    record conversion-options {
        extract-images: bool,
        // Inserts hidden HTML comments at each PDF page (`<!-- page N -->`) and
        // PPTX slide (`<!-- slide N: Name -->`) so readers can locate content.
        page-markers: bool,
    }

    record conversion-request {
        bytes: list<u8>,
        options: conversion-options,
    }

    record converted-document {
        markdown: string,
        images: list<image>,
        // Pages in the whole document, whatever range was converted.
        page-count: u32,
    }

    record conversion-error {
        code: u8,
        message: string,
    }

    // Per-page text/image accounting, used to decide which pages need OCR: a page
    // with little or no extractable text but image resources is a scanned page.
    record page-info {
        page: u32,
        text-len: u32,
        image-count: u32,
    }

    // Converts the whole document, or only the given pages. Converting
    // consecutive ranges and concatenating their Markdown in page order yields
    // exactly the whole-document Markdown; images keep the whole-document order.
    export convert: func(request: conversion-request, pages: option<page-range>) -> result<converted-document, conversion-error>;

    // Returns one entry per page with its extracted-text length and image-resource
    // count, for every page or for the given range. PDFs report real pages;
    // other formats report a single logical page.
    export page-resources: func(bytes: list<u8>, pages: option<page-range>) -> result<list<page-info>, conversion-error>;
}
