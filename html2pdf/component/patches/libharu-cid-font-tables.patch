+        ret = CIDFontType2_WriteUsedCodes ((HPDF_Font)obj);
+        if (ret != HPDF_OK)
+            return ret;
+    }
+
     if (font_attr->map_stream)
         font_attr->map_stream->filter = obj->filter;
 
