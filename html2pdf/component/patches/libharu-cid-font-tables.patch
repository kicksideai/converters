+/* Fill the 'W' array and the "CIDToGIDMap" stream of a UTF font with the code
+ * points whose glyphs the document uses. Other code points keep the default
+ * width and glyph 0; the page content never shows them. */
+static HPDF_STATUS
+CIDFontType2_WriteUsedCodes  (HPDF_Font parent)
+{
+    static const HPDF_BYTE zeros[512] = {0};
+    HPDF_FontAttr attr = (HPDF_FontAttr)parent->attr;
+    HPDF_FontDef fontdef = attr->fontdef;
+    HPDF_TTFontDefAttr fontdef_attr = (HPDF_TTFontDefAttr)fontdef->attr;
+    HPDF_Array array = HPDF_Dict_GetItem (attr->descendant_font, "W",
+                HPDF_OCLASS_ARRAY);
+    HPDF_INT16 dw = fontdef->missing_width;
+    HPDF_Array run = NULL;
+    HPDF_UINT next_code = 0;
+    HPDF_UINT written = 0;
+    HPDF_UINT seg = 0;
+    HPDF_UINT code;
+
+    if (!array || HPDF_Array_Items (array) > 0)
+        return HPDF_OK;
+
+    for (code = 0; code <= 0xFFFF; code++) {
+        HPDF_UINT16 gid = HPDF_TTFontDef_GetGlyphidFrom (fontdef,
+                    (HPDF_UINT16)code, &seg);
+        HPDF_INT w;
+
+        if (gid == 0 || gid >= fontdef_attr->num_glyphs ||
+                !fontdef_attr->glyph_tbl.flgs[gid])
+            continue;
+
+        w = HPDF_TTFontDef_GetGidWidth (fontdef, gid);
+        if (w != dw) {
+            if (!run || code != next_code) {
+                if (HPDF_Array_AddNumber (array, code) != HPDF_OK)
+                    return HPDF_Error_GetCode (parent->error);
+
+                run = HPDF_Array_New (parent->mmgr);
+                if (!run || HPDF_Array_Add (array, run) != HPDF_OK)
+                    return HPDF_Error_GetCode (parent->error);
+            }
+            if (HPDF_Array_AddNumber (run, w) != HPDF_OK)
+                return HPDF_Error_GetCode (parent->error);
+            next_code = code + 1;
+        } else
+            run = NULL;
+
+        if (attr->map_stream) {
+            HPDF_BYTE u[2];
+
+            while (written < code) {
+                HPDF_UINT n = (code - written) * 2;
+
+                if (n > sizeof (zeros))
+                    n = sizeof (zeros);
+                if (HPDF_Stream_Write (attr->map_stream->stream, zeros, n)
+                        != HPDF_OK)
+                    return HPDF_Error_GetCode (parent->error);
+                written += n / 2;
+            }
+            u[0] = (HPDF_BYTE)(gid >> 8);
+            u[1] = (HPDF_BYTE)gid;
+            if (HPDF_Stream_Write (attr->map_stream->stream, u, 2) != HPDF_OK)
+                return HPDF_Error_GetCode (parent->error);
+            written = code + 1;
+        }
+    }
+
+    return HPDF_OK;
+}
