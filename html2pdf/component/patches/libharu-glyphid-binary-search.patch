         return 0;
     }
 
-    for (i = 0; i < seg_count; i++) {
-        if (unicode <= *pend_count)
-            break;
-        pend_count++;
+    /* end_count is sorted (TrueType cmap format 4), so find the first
+     * segment whose end is not below unicode by binary search. */
+    if (cursor) {
+        i = *cursor;
+        while (i < seg_count && pend_count[i] < unicode)
+            i++;
+        *cursor = i;
+    } else {
+        HPDF_UINT lo = 0;
+        HPDF_UINT hi = seg_count;
+
+        while (lo < hi) {
+            HPDF_UINT mid = lo + (hi - lo) / 2;
+
+            if (pend_count[mid] < unicode)
