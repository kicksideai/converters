+/* With a cursor, codes must not decrease between calls: the segment search
+ * continues from the previous segment instead of starting over. */
+HPDF_UINT16
+HPDF_TTFontDef_GetGlyphidFrom  (HPDF_FontDef   fontdef,
+                                HPDF_UINT16    unicode,
+                                HPDF_UINT     *cursor)
 {
